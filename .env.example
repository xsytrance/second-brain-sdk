# Second Brain environment configuration
# Copy to ~/.env or export in shell

# Brain storage location (default: ~/.second-brain)
# SECOND_BRAIN_DIR=~/.second-brain

# Remote server mode (uncomment to use HTTP instead of local DB)
# SECOND_BRAIN_SERVER_URL=http://localhost:8009
# SECOND_BRAIN_TOKEN=tok_...

# Hermes plugin debug
# HERMES_SECOND_BRAIN_DEBUG=1
